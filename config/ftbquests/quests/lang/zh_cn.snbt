{
	chapter.09933CE28D084DB1.title: "奥术工业"
	chapter.22892B39A985EC54.title: "农贸市场"
	chapter.58AD5AF80722331D.title: "欢迎来到GuGuCraft！"
	chapter.725884AB89488808.title: "基础研究"
	chapter.74FD9793EBF983AF.title: "从零开始"
	chapter.7E04319371B01AD0.title: "路线"
	chapter_group.3C63A0CCCA15A8F0.title: "Event"
	chapter_group.5B35751FF01CB70D.title: "GuGuCraft Expert DLC"
	quest.007B65D803243E64.quest_desc: [
		"手动给炮塔发红石信号太累了？&a定时法术炮塔&f会按设定的间隔自己施法，从此你的法术产线可以彻底挂机。"
		""
		"上缴&a256个奥术构件&f，解锁定时法术炮塔。"
		""
		"&c请勿把它对准走廊。“定时” 的意思是它会准时招呼每一个路过的人。"
	]
	quest.007B65D803243E64.quest_subtitle: "准时上班"
	quest.007B65D803243E64.title: "定时法术炮塔"
	quest.01BC60D82AA148BA.quest_desc: [
		"监守者甲壳硬得离谱，碾碎之后，碎屑里只有一小部分称得上 “可用”。负责挑拣的不是机器，而是一只眼光毒辣的&a探宝蟹&f。"
		""
		"上缴&a256个奥术构件&f，解锁探宝蟹护符与相关的筛分工艺。"
		""
		"&c探宝蟹按件计酬，报酬是魔源。它从不讨价还价，因为它根本不给你还价的机会。"
	]
	quest.01BC60D82AA148BA.quest_subtitle: "按件计酬"
	quest.01BC60D82AA148BA.title: "探宝蟹"
	quest.03A125733BA8FA67.quest_desc: [
		"传送石碑的老朋友&a传送粉&f在研究所找到了新工作：它对某些植物有着相当奇妙的“催化”效果。"
		""
		"至于是哪些植物，就请你自己去翻资料了。"
	]
	quest.03A125733BA8FA67.quest_subtitle: "不止能传送"
	quest.03A125733BA8FA67.title: "传送粉"
	quest.05A7B43F69E20BDB.quest_desc: [
		"收容只是第一步。我们还需要一位不怕监守者、又勤劳肯干的员工——&a德格米&f。它会从附近的生物身上 “收集” 东西，而且不会伤到罐子里的住户。"
		""
		"上缴&a256个奥术构件&f，解锁德格米石阵与德格米护符。"
		""
		"&c德格米不挑食，所以它带回来的东西也是一锅乱炖。分拣归你。"
	]
	quest.05A7B43F69E20BDB.quest_subtitle: "勤劳的新同事"
	quest.05A7B43F69E20BDB.title: "德格米"
	quest.0776FD82E9C13041.title: "122"
	quest.0A013D26F6121D5F.quest_desc: [
		"基础法术炮塔已经在蔓延器旁边上岗了，可它们只会照着那张羊皮纸干活。想让炮塔帮你砍树、收庄稼、剪羊毛？那就得自己写法术了。"
		""
		"上缴&a256个奥术构件&f，解锁破坏、砍伐、收获、拾取、剪切字形与 “敏感” 增强。"
		""
		"&c砍伐法术分不清树和木屋。请先确认你的宿舍是不是木头做的。"
	]
	quest.0A013D26F6121D5F.quest_subtitle: "炮塔的新课程"
	quest.0A013D26F6121D5F.title: "采集法术"
	quest.0A374A4C03BAE12B.quest_desc: [
		"研究所自己养出来的幽匿块。"
		""
		"&c请勿带回宿舍。"
	]
	quest.0A374A4C03BAE12B.quest_subtitle: "自产自销"
	quest.0A374A4C03BAE12B.title: "幽匿块"
	quest.0AD937A0448E5A06.quest_desc: ["探宝蟹从一堆碎屑里挑出来的精品。它对自己的眼光非常满意。"]
	quest.0AD937A0448E5A06.quest_subtitle: "精挑细选"
	quest.0AD937A0448E5A06.title: "淬炼甲壳"
	quest.0CB5D621AADA2CF4.quest_desc: [
		"&6恭喜，实验员——你造出了奥术构件，而且（暂时）没有长出紫色的胡子。欢迎调入奥术工业部。"
		""
		"基础研究教会了你怎么做出奥术构件，这里要教你怎么花掉它。从现在起，奥术构件就是本部门唯一认可的研发经费，每一台新设备、每一道新工艺都要拿它来换。"
		""
		"作为入职手续，请向终端上缴&a64个奥术构件&f。"
		""
		"&c本部门的终极目标写在档案的最后一页：“打开通往另一个世界的门”。没人知道门那边有什么，所以我们决定派你去。"
	]
	quest.0CB5D621AADA2CF4.quest_subtitle: "入职手续"
	quest.0CB5D621AADA2CF4.title: "奥术工业"
	quest.0DDF1A6636380BF4.quest_desc: [
		"还记得那些从地底深处钻出来的银色矿石吗？材料部给它起名叫&b秘银&f，并宣布它是一切奥术研究的地基——前提是你能把它从矿渣里提炼出来。"
		""
		"提炼工艺目前还锁在数据库里。规矩照旧：向终端上缴&a512个动力构件&f作为研发经费，秘银的加工许可就归你了。"
		""
		"&c友情提示：秘银的胃口可不小。后勤部看了一眼它的原料清单，就开始默默更新自己的简历。"
	]
	quest.0DDF1A6636380BF4.quest_subtitle: "比钢更硬，比钱包更薄"
	quest.0DDF1A6636380BF4.title: "秘银"
	quest.0E86442281471FCD.quest_desc: [
		"在炼金术士眼里，万物都由 “躯体” 和 “灵魂” 组成：盐是躯体，硫是灵魂。要复制幽匿的力量，得先把它拆开。"
		""
		"上缴&a512个奥术构件&f，解锁幽匿的煅烧与液化工艺，以及远程供热用的&d流态热质发射器&f。"
		""
		"&c幽匿之硫的产量少得可怜。别急，下一项研究就是为它准备的。"
	]
	quest.0E86442281471FCD.quest_subtitle: "躯体与灵魂"
	quest.0E86442281471FCD.title: "盐与硫"
	quest.0EA1B4E371713261.title: "下界合金喷气背包"
	quest.110C5677FA49998A.quest_desc: [
		"魔源浆果长得太慢，高产路线的发酵罐已经开始 “饿肚子” 了。生态部推荐了一位绿色的帮手：&a风转草&f——它待过的地方，作物都会长得飞快。"
		""
		"上缴&a256个奥术构件&f，解锁风转草护符。"
		""
		"&c它喜欢在田里跳舞。请不要和它比赛，你会输。"
	]
	quest.110C5677FA49998A.quest_subtitle: "绿色的帮手"
	quest.110C5677FA49998A.title: "风转草"
	quest.128A83BF0B506781.quest_desc: [
		"把你的手指从鼠标左键上移开，新人。看到那个显眼的黄色警告了吗？"
		""
		"这并非系统故障，而是研究所的一项仁慈举措。鉴于后期实验需要吞吐的数据量足以让普通人的腕管瞬间报废，我们研发了一种能直接对接物流系统的“自动化接口”。简而言之，未来你只需把成吨的物资倒进漏斗，机器就会自动完成数字化上传。没有疯狂点击，没有肌肉酸痛，只有齿轮转动的悦耳声响。"
		""
		"不过，先别急着找这台机器。你目前的安全许可还不足以申领这种高端设备。这个任务只是为了让你眼馋一下未来的自动化生活，顺便提醒你不要试图用蛮力挑战我们的数据库。"
		""
		"&c请继续推进基础课程，当你证明自己不会把实验室炸上天后，相应的设备蓝图自然会解锁。"
	]
	quest.128A83BF0B506781.quest_subtitle: "拯救你的鼠标"
	quest.128A83BF0B506781.title: "另一种研究方式"
	quest.12ECA55559922DE4.quest_desc: ["再请一只幻翼来做客。它在罐子里也照样只上夜班。"]
	quest.12ECA55559922DE4.quest_subtitle: "夜班同事"
	quest.12ECA55559922DE4.title: "收容：幻翼"
	quest.13E5764E3D9A257A.quest_desc: [
		"每次都跑去深暗之域挖幽匿块？后勤部拒绝签字。工程部的方案是把幽匿 “养” 在研究所里：给它魔源和经验，它自己就会长满周围的石头。"
		""
		"上缴&a384个奥术构件&f，解锁幽匿蔓延器。"
		""
		"&4严禁把蔓延器放在宿舍楼附近。自从上次事故以后，三楼至今仍在 “蔓延”。"
	]
	quest.13E5764E3D9A257A.quest_subtitle: "室内养殖"
	quest.13E5764E3D9A257A.title: "幽匿蔓延器"
	quest.142E41E10006D041.quest_desc: [
		"苦力怕的爆炸不在设备保修范围内。为了防止你哭着重造流水线，这批照明方案能提供一种“战略性强光压制”。"
		""
		"&c记住：只有把光照拉满，你的加班环境才足够安全。"
	]
	quest.142E41E10006D041.quest_subtitle: "防刷怪利器"
	quest.142E41E10006D041.title: "超级火把"
	quest.14C200AAF981B8C0.quest_desc: ["第一颗人造回响碎片。考古部已经开始写辞职信了。"]
	quest.14C200AAF981B8C0.quest_subtitle: "人造的"
	quest.14C200AAF981B8C0.title: "回响碎片"
	quest.14E13CF3DED8D236.quest_desc: [
		"德格米负责产出，分拣却全靠你一个人跑腿？物流科雇来了一位毛茸茸的临时工：&a星宝石兽&f，它会在容器之间任劳任怨地搬运物品。"
		""
		"上缴&a256个奥术构件&f，解锁星宝石兽护符。"
		""
		"&c它干活时总是蹦蹦跳跳的。请注意脚下。"
	]
	quest.14E13CF3DED8D236.quest_subtitle: "毛茸茸的临时工"
	quest.14E13CF3DED8D236.title: "星宝石兽"
	quest.14F992B07C3BEFA9.quest_desc: [
		"把你的扳手准备好，实验员，我们即将接触真正的重工业技术。呈现在你面前的是“演算终端”，它是整个自动化提交流程的大脑。"
		""
		"&a特别提醒&f： 鉴于这台机器对量子算力（其实是服务器负载）的巨大消耗，&c每个科研小队仅获准建造一台&f。别贪心，只要你还没打算把整个维度的资源都挖空，一台终端的吞吐量绝对够用了。"
		""
		"搭建完成后，请确保接入了足够的应力。动起来吧，机器可不会自己把自己装好！"
	]
	quest.14F992B07C3BEFA9.quest_subtitle: "工业结晶"
	quest.156D64CD59334840.quest_desc: [
		"灌注可不是往台子上随便摆点东西就行的。后勤部已经把需要准备的材料列在了任务目标里。"
		""
		"&c别问为什么需要一颗金蛋。我们问过，研究主管只是神秘地笑了笑。"
	]
	quest.156D64CD59334840.quest_subtitle: "仪式感很重要"
	quest.156D64CD59334840.title: "灌注材料"
	quest.15F92C8B6180BBCD.quest_desc: ["将提交速度提升至 &a8 / tick"]
	quest.15F92C8B6180BBCD.quest_subtitle: "Tier 2"
	quest.15F92C8B6180BBCD.title: "输入速率升级 II"
	quest.19F7CB808D8E2DCC.quest_desc: ["七日后失效"]
	quest.1ADFEAFE92E08F24.quest_desc: [
		"&6恭喜存活，实验员！既然那台演算终端没有因为短路把你烤熟，欢迎正式进入基础研究部门。"
		""
		"这里不再是过家家了。本部门掌管着演算终端的核心升级组件与各类实用物件，想要获取它们，你必须证明自己的产线具备“工业级”的吞吐量。"
		""
		"作为入场券，请向系统灌入256个动力构件。如果你还在试图徒手完成这个指标，建议直接去医务室预订床位。去检查你的自动化产线吧，让那些机器全速运转起来！"
	]
	quest.1ADFEAFE92E08F24.quest_subtitle: "开端"
	quest.1ADFEAFE92E08F24.title: "基础研究"
	quest.1EFBD868961A12B4.quest_desc: [
		"不是所有魔法都要轰轰烈烈。后勤部整理了一批 “懒人法术”：随身合成、换个颜色、把东西扔远点——专治各种不想走路。"
		""
		"上缴&a256个奥术构件&f，解锁合成、戏法、Wololo与投掷字形。"
		""
		"&c禁止用 Wololo 给同事的羊换颜色。上周那只粉色的羊至今还在申诉。"
	]
	quest.1EFBD868961A12B4.quest_subtitle: "懒人法术"
	quest.1EFBD868961A12B4.title: "生活法术"
	quest.1FCB6867A133AADB.quest_desc: [
		"想把监守者请进收容罐，光靠勇气是不够的，还得让它 “站好别动”。行为管理科整理了一套让目标乖乖听话的法术。"
		""
		"上缴&a256个奥术构件&f，解锁禁锢、击退、吸引、冻结与泡泡字形。"
		""
		"&4再次声明：这些法术对监守者有效，但对它的心情无效。"
	]
	quest.1FCB6867A133AADB.quest_subtitle: "站好别动"
	quest.1FCB6867A133AADB.title: "控制法术"
	quest.2033516B0E3F66E1.quest_desc: [
		"奥术工业部的魔源罐已经从一楼摆到了楼顶，后勤部每天抱着罐子上上下下，膝盖比预算先报废了。"
		""
		"&b魔源中转器&f能把魔源隔空送到需要的地方——收集、存放、分流，一应俱全。上缴&a256个奥术构件&f，解锁魔源中转器全系列。"
		""
		"&c中转器之间的光束不是晾衣绳，请勿悬挂实验服。"
	]
	quest.2033516B0E3F66E1.quest_subtitle: "隔空送魔源"
	quest.2033516B0E3F66E1.title: "魔源物流"
	quest.21486D4A2E6BF8A7.quest_desc: ["将提交速度提升至 &a16 / tick"]
	quest.21486D4A2E6BF8A7.quest_subtitle: "Tier 3"
	quest.21486D4A2E6BF8A7.title: "输入速率升级 III"
	quest.25135B4F929E1EDF.quest_desc: [
		"&5深渊之心&f——据说能打开另一个世界的心脏。研究所的计划很简单：既然它原本长在监守者身上，那就……请一只监守者来研究所做客。"
		""
		"新生魔艺的收容仪式能把生物装进罐子里。上缴&a128个奥术构件&f，解锁仪式火盆、收容仪式与收容罐。"
		""
		"&4医疗部提醒：监守者看不见，但它听得见你的心跳。建议出发前更新遗嘱。"
	]
	quest.25135B4F929E1EDF.quest_subtitle: "请客容易送客难"
	quest.25135B4F929E1EDF.title: "收容"
	quest.25FA6209BD88BBDD.quest_desc: ["神圣金相关的设备需要用到&a繁茂至高木&f。这种树在研究所附近可不常见，想要稳定的木材供应，你得想办法自己种。"]
	quest.25FA6209BD88BBDD.quest_subtitle: "会长魔力的树"
	quest.25FA6209BD88BBDD.title: "繁茂至高木"
	quest.2806210C82CB96DF.quest_desc: [
		"液态魔源的蓄积需要用到&a魔源浆果&f。"
		""
		"&c它们是实验耗材，不是零食。上周有人把一整箱当下午茶吃了，现在他打嗝会冒火花。"
	]
	quest.2806210C82CB96DF.quest_subtitle: "实验耗材，禁止食用"
	quest.2806210C82CB96DF.title: "魔源浆果"
	quest.28EF8F833313DCFC.quest_desc: [
		"很好，看来你没有把那些构件偷偷拿去换成面包。现在，我们要把这些零散的部件变成“演算终端”。"
		""
		"这可不是那种随便往地上一扔就能跑的傻瓜设备，这是一座精密的多方块结构。如果你试图凭空瞎摆，我保证它除了冒烟什么都不会做。请务必把光标对准演算终端的图标并&a长按 [W] 键，进入“思索”模式&f。那里有我们为你准备的全息投影教程——如果连动态演示都教不会你，那我也没辙了。"
		""
		"为了防止你掰手指头算错数，后勤部已经贴心地把所有需要的建筑材料列在了任务目标里。"
		""
		"&c找一块宽敞的地基，接好足够的应力源，把这台吞噬数据的怪兽造出来吧。祝你好运，别把实验室炸了。"
	]
	quest.28EF8F833313DCFC.quest_subtitle: "建造需求"
	quest.28EF8F833313DCFC.title: "演算终端的搭建"
	quest.2B6158DD8EC3B428.quest_desc: [
		"有了液态魔源，我们终于可以对黄金下手了。研究所的目标是把普通的金子“净化”成&6神圣金&f——一种据说被魔力祝福过、实际上主要被财务部诅咒过的金属。"
		""
		"向终端上缴&a1024个动力构件&f，解锁净化与灌注所需的全套设备。"
		""
		"&c注意：第一块神圣金总是最难的。等你凑齐它的时候，你会对“万事开头难”有全新的理解。"
	]
	quest.2B6158DD8EC3B428.quest_subtitle: "点石成金，字面意思"
	quest.2B6158DD8EC3B428.title: "神圣金"
	quest.2B99EF870C236588.quest_desc: [
		"醒过来的催发体。"
		""
		"&c它在看你。"
	]
	quest.2B99EF870C236588.quest_subtitle: "它醒了"
	quest.2B99EF870C236588.title: "活化幽匿催发体"
	quest.2DB4B26CBBA3605F.quest_desc: [
		"勘探部花了大半年，终于在地下找到了天然的&b秘银溶剂脉&f。只要把乙醇灌进钻井，就能把它抽上来，秘银混合物总算不用再往搅拌机里扔了。"
		""
		"这不是必修课，但财务部强烈建议你选修：上缴&a512个奥术构件&f，解锁流体钻井。"
		""
		"&c这是本部门唯一一笔 “花钱是为了以后少花钱” 的预算。"
	]
	quest.2DB4B26CBBA3605F.quest_subtitle: "选修课"
	quest.2DB4B26CBBA3605F.title: "流体钻井"
	quest.33DB8C8E6A064202.quest_desc: [
		"奥术工业部的设备个个都是大胃王，可它们吃的不是液态魔源，而是&b魔源&f——两者的区别，大概相当于面粉和面包。"
		""
		"&b魔源转化器&f负责把液态魔源 “烤” 成魔源，烤炉底下得有一只烧得正旺的&a御炎火盆&f。上缴&a128个奥术构件&f，解锁魔源转化器。"
		""
		"&c转化器对储液量很挑剔：少了怠工，多了撑着。是的，它比你还难伺候。"
	]
	quest.33DB8C8E6A064202.quest_subtitle: "部门电费"
	quest.33DB8C8E6A064202.title: "魔源转化器"
	quest.33DBBC295C8C1B16.quest_desc: ["幽匿的 “躯体”。看起来像一碗盐，尝起来……别尝。"]
	quest.33DBBC295C8C1B16.quest_subtitle: "躯体"
	quest.33DBBC295C8C1B16.title: "幽匿之盐"
	quest.350E5B96AEA079A7.quest_desc: [
		"听好了，新人。在 GuGu 研究所，知识可不是免费的午餐——它是通过“物质转化数据”来换取的。"
		""
		"机制非常直观：你在这个终端上查阅研究所急需的物资清单（比如这堆看起来平平无奇的原木），一旦你提交了足额的样品，中央数据库就会为你解锁相应的高级技术蓝图。我们将其称为“等价交换”……或者说，是我们懒得自己去采集原材料的借口。"
		""
		"&4重要警告：&f 现在我们要的可能只是一组木头，这很简单。但随着科研等级提升，未来的项目将需要海量的资源吞吐。如果你真的打算靠那把可怜的斧头手动采集几万个资源，职业病防治科的医生会很乐意在你的病历上写满嘲笑。"
		""
		"&c为了你的鼠标寿命（和你的精神健康）着想，请尽快学会搭建自动化生产线来满足我们的胃口。"
	]
	quest.350E5B96AEA079A7.quest_subtitle: "最基础的研究方式"
	quest.350E5B96AEA079A7.title: "如何进行研究？"
	quest.367B4364CEFBD3F1.quest_desc: [
		"幽匿之硫稀有到财务部开始考虑给它上保险。好在神通术有一门叫&b重塑&f的手艺：只要有一份样本，就能借汞的能量，把平凡的硫 “改写” 成样本的模样。"
		""
		"上缴&a768个奥术构件&f，解锁流态硫发射器与重塑台座。"
		""
		"&c样本请务必保管好。弄丢样本的实验员，得亲自去德格米那儿再排一次队。"
	]
	quest.367B4364CEFBD3F1.quest_subtitle: "照着样本抄"
	quest.367B4364CEFBD3F1.title: "重塑"
	quest.36EFBB37362A750D.quest_desc: [
		"研究所终于批准了你的魔法执照。别激动，这只是&a初学者法术书&f——相当于魔法界的自行车辅助轮。"
		""
		"上缴&a128个奥术构件&f，解锁抄写台、初学者法术书、法术羊皮纸，以及最基础的几种字形。更多的字形会随着研究推进陆续开放。"
		""
		"&c第一次施法请对着空地。上一个对着镜子施法的实验员，至今还在和自己的倒影吵架。"
	]
	quest.36EFBB37362A750D.quest_subtitle: "魔法执照"
	quest.36EFBB37362A750D.title: "法术入门"
	quest.3974744BE1CB4D7E.quest_desc: ["若无其他意外情况，服务器将&4持续运行&f，存档也将&4长期保留&f，所以不必担心自己辛苦建造的成果随存档更换而消失"]
	quest.3974744BE1CB4D7E.title: "服务器状况"
	quest.3B1BA1B9DC394B51.quest_desc: [
		"如果在外面捡到了超出你当前认知、甚至闪烁着诡异微光的“&c未知物品&f”，听我一句劝，千万别用舌头去尝它！"
		""
		"鉴于之前有实验员因乱摸高维零件而引发了数起实验室爆炸，后勤部特制了这款“&a未知之袋&f”。任何你目前无法解析的神秘物品，都会被它自动强制收容，免得你一不小心把自己蒸发掉。"
		""
		"这些宝贝并没有消失。一旦你在终端完成了对应技术的研究，只需手持这个布袋按下右键，被扣押的物资就会安全地物归原主。&a祝你好运，希望你真的能走大运&f！"
	]
	quest.3B1BA1B9DC394B51.quest_subtitle: "那你走大运了"
	quest.3B1BA1B9DC394B51.title: "意外捡到了没见过的东西？"
	quest.3B4136E1987AADBD.quest_desc: ["德格米的第一批战利品。闻起来像熬夜加班。"]
	quest.3B4136E1987AADBD.quest_subtitle: "第一批战利品"
	quest.3B4136E1987AADBD.title: "幻翼膜"
	quest.3D2A818D220469DF.quest_desc: [
		"研究所的走廊越来越长，产线越铺越广，电梯却迟迟不批。既然预算不够，那就让自己跳得更高、飞得更远一点。"
		""
		"上缴&a256个奥术构件&f，解锁腾跃、发射、风爆、弹性字形与 “脚下” 形态。"
		""
		"&c落地是你自己的事。医疗部已经在楼下铺好了干草块。"
	]
	quest.3D2A818D220469DF.quest_subtitle: "跳得更高"
	quest.3D2A818D220469DF.title: "机动法术"
	quest.3DF01E01D8045FD0.quest_desc: ["敬请期待"]
	quest.3DF01E01D8045FD0.title: "并行任务升级"
	quest.431019A7FFCD9CC1.quest_desc: [
		"第一片汞晶碎片。摸起来凉凉的。"
		""
		"&c请勿舔舐。"
	]
	quest.431019A7FFCD9CC1.quest_subtitle: "请勿舔舐"
	quest.431019A7FFCD9CC1.title: "汞晶碎片"
	quest.4449D408A6115C65.quest_subtitle: "狂野，只用一种"
	quest.4449D408A6115C65.title: "野火灯笼"
	quest.44B1E48CEE165775.quest_desc: [
		"欢迎来到本章的终点：&d奥术构件&f。它把机械的严谨和魔法的不讲道理塞进了同一个零件里，也是研究所下一阶段所有奥术研究的“货币”。"
		""
		"最后一笔经费：&a2048个动力构件&f与&a512个精密构件&f。解锁之后，请立刻着手它的量产——相信我，你会需要非常、非常多的奥术构件。"
		""
		"&4医疗部提醒：长时间注视奥术构件可能导致胡子发出紫光，研究所对此概不负责。"
	]
	quest.44B1E48CEE165775.quest_subtitle: "本章终点"
	quest.44B1E48CEE165775.title: "奥术构件"
	quest.44DDEE323451701D.quest_desc: ["敬请期待"]
	quest.44DDEE323451701D.title: "升级占位符1"
	quest.47E085E69978417A.quest_desc: ["双腿行走不仅低效，还磨损地板。感谢 PssbleTrngle™ 的慷慨赞助，我们赋予你脱离地心引力的特权。穿上喷气背包起飞吧——但请注意，天花板维修费需自理。"]
	quest.47E085E69978417A.title: "喷气背包"
	quest.4814A8F6D9096474.quest_desc: ["德格米的第一批战利品。硬得离谱，先别急着拿它做盔甲。"]
	quest.4814A8F6D9096474.quest_subtitle: "第一批战利品"
	quest.4814A8F6D9096474.title: "监守者甲壳"
	quest.4885FF74AF80B50F.quest_desc: [
		"所有原料都已就位，现在需要一张够大的工作台把它们组合起来——&d附魔装置&f，以及它脚下的&d奥术核心&f。第一件作品：&b强化回响碎片&f。"
		""
		"上缴&a768个奥术构件&f，解锁附魔装置与奥术核心。"
		""
		"&c基座上的东西放错一个，整炉就白费了。操作时请勿打喷嚏。"
	]
	quest.4885FF74AF80B50F.quest_subtitle: "汇合"
	quest.4885FF74AF80B50F.title: "附魔装置"
	quest.49FF3C14FEECCAE6.quest_desc: [
		"研究所附近的怪物越来越多，安保科表示他们只负责看门，不负责打架。"
		""
		"上缴&a256个奥术构件&f，解锁伤害、点燃、蒸发、解除魔法、召唤狼与召唤骏马字形。"
		""
		"&c召唤出来的狼到点就会回家。请不要给它们起名字，分别的时候会很难过。"
	]
	quest.49FF3C14FEECCAE6.quest_subtitle: "安保外包"
	quest.49FF3C14FEECCAE6.title: "战斗法术"
	quest.4E02622DDA832F7F.quest_desc: ["如果你是被其他朋友介绍进服的，别忘了加入我们的&a官方QQ群：613726820"]
	quest.4E02622DDA832F7F.title: "交流群指南"
	quest.5080A08A5244278D.quest_desc: [
		"从这里开始，研究所正式踏入&b神通术&f的炼金领域。一切的起点是&b汞&f——它既是原料，也是驱动炼金设备的能量。"
		""
		"上缴&a512个奥术构件&f，解锁汞蒸馏器与汞催化器。"
		""
		"&c汞晶碎片不是糖果，也不是硬币。请不要把它们塞进自动售货机。"
	]
	quest.5080A08A5244278D.quest_subtitle: "流动的能量"
	quest.5080A08A5244278D.title: "汞"
	quest.536171A3638882E5.title: "占位符1-1"
	quest.53C54B9E16BBD469.quest_desc: ["幽匿的 “灵魂”。稀有，而且脾气不好。"]
	quest.53C54B9E16BBD469.quest_subtitle: "灵魂"
	quest.53C54B9E16BBD469.title: "幽匿之硫"
	quest.54EAE16EABEE8F0F.quest_desc: [
		"理论课结束了，实验员。现在我们来看看你的动手能力是否和你的阅读理解能力一样……凑合。"
		""
		"想要获得那台高端“演算终端”的建造许可吗？没那么容易。根据研究所《物资管理条例》第404条，你需要先证明自己掌握了最基础的动能工艺。现在的任务很简单：向系统提交8个&a动力构件&f。"
		""
		"这些构件是这台复杂机械的心脏。虽然对于这区区8个样品，你可以选择趴在工作台上像个疯狂的木匠一样徒手搓出来，但我强烈建议你借此机会尝试一下序列组装。"
		""
		"&c当然，如果你打算靠手搓来完成未来成千上万的订单，我就得提前通知医疗部为你预订手指康复疗程了。"
	]
	quest.54EAE16EABEE8F0F.quest_subtitle: "逐步解锁"
	quest.54EAE16EABEE8F0F.title: "研究练习1"
	quest.5939C56A0E871225.quest_desc: [
		"如何&a邀请朋友&f进服？"
		""
		"没有任何限制，只需要告诉他QQ群号即可"
	]
	quest.5939C56A0E871225.title: "邀请指南"
	quest.5ACF65004EF1DD06.quest_desc: [
		"刚才监测到当你查看“推演机壳”的配方时，血压读数出现了显著上升。深呼吸，新人，在实验室晕倒会被扣工资的。"
		""
		"好消息是，那个工艺复杂的机壳目前仅用于组装“演算终端”，这意味着你暂时不需要为此搭建一条会让你掉头发的自动化产线。对此您可以稍后再感谢研究所的仁慈。"
		""
		"但坏消息是，我们依然需要一些物资。请向系统提交16个&a动力构件&f与8个&a坚固板&f。"
		""
		"这笔交易将为你解锁“应力输入口”和“提交接口”的制造权限——通俗地说，就是那台机器的“胃”和“嘴”。虽然理论上你可以继续用那把可怜的锤子敲打出这些零件，但考虑到未来的需求量，现在就开始尝试自动化生产是个明智的选择。"
		""
		"&c当然，如果你就是喜欢盯着工作台发呆，我们也尊重你的个人爱好。"
	]
	quest.5ACF65004EF1DD06.quest_subtitle: "逐步解锁"
	quest.5ACF65004EF1DD06.title: "研究练习2"
	quest.5CF611A89C4A3460.quest_desc: [
		"嫌弃终端吞噬物资像在品茶？这套超频升级方案能把它的进食方式从“细嚼慢咽”变成“暴风吸入”。别让漫长的进度条成为你偷懒的借口，效率就是一切！"
		""
		"将提交速度提升至 &a4 / tick"
	]
	quest.5CF611A89C4A3460.quest_subtitle: "Tier 1"
	quest.5CF611A89C4A3460.title: "输入速率升级 I"
	quest.5DED629CCC9E3DCF.quest_desc: ["离心机甩出来的第一桶树液。闻起来像整片森林，但请别拿它泡茶。"]
	quest.5DED629CCC9E3DCF.quest_subtitle: "森林的味道"
	quest.5DED629CCC9E3DCF.title: "至高木树液"
	quest.5F262010FF62FC8C.quest_desc: ["内容正在施工中，流程极为不完整，仅为可玩状态。如遇bug等问题请联系群主&6@全自动鸽子&f反馈"]
	quest.5F262010FF62FC8C.quest_subtitle: "Extremely WIP !!!"
	quest.5F262010FF62FC8C.title: "观前提示"
	quest.5F8D54587D37CCEC.quest_desc: [
		"&4最基本的规则&f是所作所为不能影响到服务器的正常运作"
		""
		"除此之外服务器没有其他限制，只要不影响到其他玩家正常游玩，你可以自由探索这个世界"
	]
	quest.5F8D54587D37CCEC.title: "服务器守则"
	quest.6049542338A30466.quest_desc: [
		"盐、硫、汞三者齐备，就能在&b培育器&f里让它们重新结合成实物。研究所第一次能够 “制造” 回响碎片，而不必去远古城市的箱子里翻找。"
		""
		"上缴&a768个奥术构件&f，解锁培育器及三种容具。"
		""
		"&c考古部对此强烈抗议：他们的出差补贴没了。"
	]
	quest.6049542338A30466.quest_subtitle: "人造回响"
	quest.6049542338A30466.title: "培育"
	quest.6102986E979E25AD.quest_desc: [
		"秘银的炼制离不开大量的&a下界合金&f。靠挖远古残骸是凑不够的，你需要一条能自己持续产出下界合金的产线。"
		""
		"&c别指望后勤部替你去下界挖矿，他们连食堂都懒得去。"
	]
	quest.6102986E979E25AD.quest_subtitle: "稳定货源"
	quest.6102986E979E25AD.title: "下界合金"
	quest.61225D16E85DC829.title: "EXPERT DLC KEY"
	quest.619CC9255627D69D.quest_desc: ["除开&a新年&f的固有合影活动之外，服务器将&a不定期&f举行一些小活动，欢迎积极参与"]
	quest.619CC9255627D69D.title: "服务器活动"
	quest.65094E8DF35B6220.quest_subtitle: "防蝙蝠利器"
	quest.65094E8DF35B6220.title: "恐惧灯"
	quest.66435C3FE4214FE7.quest_desc: [
		"欢迎入职，第 [数据删除] 号实验员！既然你能读到这段文字，说明你已经成功通过了我们的人体耐受性测试——或者只是单纯地捡到了这本操作终端。"
		""
		"此处是GuGu研究所，本维度最顶尖（也是最吵闹）的技术中心。我知道你在想什么：“为什么要在这种地方搞科研？”别问，这是商业机密。本章节的核心目标非常简单：我们将指导你从零开始搭建一套“研究系统”。"
		""
		"这不仅仅是为了让你看起来像个科学家，更因为许多高阶的机械蓝图已被我们锁在数据库深处。想要解锁那些稍微违反物理定律的设备，你就必须通过该系统提交研究数据。别再像个原始人一样只会在工作台上敲敲打打，启动你的大脑（和锅炉），让我们开始把文明推向更高端的时代吧！"
		""
		"&c请注意：研究所不对任何因操作不当导致的应力过载或人身伤害负责。"
	]
	quest.66435C3FE4214FE7.quest_subtitle: "章节基础教程"
	quest.66435C3FE4214FE7.title: "欢迎来到GuGu研究所！"
	quest.66819D39E541F079.quest_desc: [
		"工程部想把法术和红石接在一起：埋下符文、发出信号、延时触发、随机应变。恭喜，研究所的陷阱和机关从此可以用魔法驱动了。"
		""
		"上缴&a256个奥术构件&f，解锁符文、红石信号、延迟、重置字形与 “随机化” 增强。"
		""
		"&c在自家门口埋符文之前，请先记住你埋在哪儿。"
	]
	quest.66819D39E541F079.quest_subtitle: "魔法驱动的机关"
	quest.66819D39E541F079.title: "机关法术"
	quest.66A289CDACC69976.quest_desc: [
		"德格米带回来的幽匿催发体还在 “沉睡”。在材料部看来，它们只是一团会发光的原料，离真正派上用场还差一次魔力的唤醒。"
		""
		"上缴&a256个奥术构件&f，解锁对应的灌注工艺。"
		""
		"&c唤醒之后，它会对周围的一切产生兴趣。请把午餐收好。"
	]
	quest.66A289CDACC69976.quest_subtitle: "叫醒服务"
	quest.66A289CDACC69976.title: "幽匿催发体活化"
	quest.66DD1F44726A98F2.title: "更新日志"
	quest.67505072C3D7A455.quest_desc: [
		"发酵罐的第一批成果。"
		""
		"&c再次声明：它不是酒。"
	]
	quest.67505072C3D7A455.quest_subtitle: "它不是酒"
	quest.67505072C3D7A455.title: "魔源醪液"
	quest.682EA5AD7E10C382.quest_desc: [
		"秘银、液态魔源、神圣金……原料已经到齐，是时候把它们熔为一炉了。&d奥术锭&f是秘银与魔源的结晶，而&d奥术板&f是它被机器压扁之后的样子——没错，我们对待魔法的方式就是这么朴实。"
		""
		"本次研发经费：&a1024个动力构件&f与&a256个精密构件&f。精密构件的加入意味着高层终于承认，魔法也是需要一点精度的。"
	]
	quest.682EA5AD7E10C382.quest_subtitle: "把魔法压扁"
	quest.682EA5AD7E10C382.title: "奥术锭 / 奥术板"
	quest.6ADA796101C5F20F.quest_desc: [
		"工程部提交了一份报告：基础研究部那些机器其实还能再干四倍的活，前提是给它们换一身&b奥术机壳&f。"
		""
		"这不是新机器，是给旧机器穿上新外套——顺便让它们一次干四份活。上缴&a256个奥术构件&f，解锁机械动力机器的奥术升级。"
		""
		"&c升级后的机器不接受 “我只是一台普通搅拌机” 作为偷懒理由。"
	]
	quest.6ADA796101C5F20F.quest_subtitle: "选修课"
	quest.6ADA796101C5F20F.title: "奥术机器"
	quest.6B2B741F70181444.quest_desc: ["便宜又量大的硫。它本身没什么用——但只要有一份样本……"]
	quest.6B2B741F70181444.quest_subtitle: "平平无奇"
	quest.6B2B741F70181444.title: "炼金硫（深板岩）"
	quest.6BC620EF4EA84EE6.quest_desc: [
		"现有的液态魔源产量，只够让魔源转化器打个盹。接下来的每一项奥术研究都是吞魔源的无底洞，高层要求你把魔源生产升级成真正的工业。"
		""
		"工程部从仓库角落翻出两台落灰的设备，又从柴油动力的酒厂借来了一整套发酵和分馏工艺。至高木和魔源浆果在里面扮演什么角色——你很快就会知道。上缴&a128个奥术构件&f，解锁全套许可。"
		""
		"&c发酵产物不是酒。上次有人当酒喝了，现在他能用意念点燃蜡烛。"
	]
	quest.6BC620EF4EA84EE6.quest_subtitle: "魔源不再按滴计价"
	quest.6BC620EF4EA84EE6.title: "液态魔源工业化"
	quest.6C223E352605E14D.quest_desc: [
		"带一只监守者回来。活的。"
		""
		"&c罐子要结实。"
	]
	quest.6C223E352605E14D.quest_subtitle: "活的"
	quest.6C223E352605E14D.title: "收容：监守者"
	quest.6C56617CC14B9DB4.quest_desc: ["如你所见，这里是MC，做你想做的事吧"]
	quest.6C56617CC14B9DB4.title: "我能做些什么？"
	quest.6C940B32C97D8346.quest_desc: [
		"秘银到手，接下来要对付的是真正的“魔法”。高层坚持认为魔力也能像机油一样灌进管道，于是有了&b液态魔源&f这个听上去就很危险的项目。"
		""
		"为此你需要两台来自神通术的炼金设备。向终端上缴&a768个动力构件&f，解锁它们的使用许可。"
		""
		"&4再说一遍，请勿饮用。上一个这么做的实验员，现在能看见声音。"
	]
	quest.6C940B32C97D8346.quest_subtitle: "请勿饮用"
	quest.6C940B32C97D8346.title: "液态魔源"
	quest.6D87C1DF995717D7.quest_desc: ["想体验当上帝的感觉？我们确实出售修改现实的“作弊码”，但别高兴得太早。在这里，每个东西都是有标价的。准备好你的资源吧，毕竟打破第四面墙的罚款可不便宜。"]
	quest.6D87C1DF995717D7.title: "“/back”"
	quest.6DE15C580D22EACA.quest_desc: ["压实的甲壳碎屑。对探宝蟹来说，这就是一整天的工作量。"]
	quest.6DE15C580D22EACA.quest_subtitle: "探宝蟹的工作台"
	quest.6DE15C580D22EACA.title: "甲壳碎屑块"
	quest.6E146F1D5029174F.quest_desc: [
		"炼金阶段的原料清单已经长到需要翻页了。档案部推荐了一套新生魔艺的仓储方案：&a仓库&f负责存，&a存储讲台&f负责查，&a书龙&f负责跑腿。"
		""
		"上缴&a512个奥术构件&f，解锁仓库、存储讲台与书龙护符。"
		""
		"&c书龙不吃书。请不要拿这个问题考验它。"
	]
	quest.6E146F1D5029174F.quest_subtitle: "档案部推荐"
	quest.6E146F1D5029174F.title: "魔法仓储"
	quest.73B7FC9397EA5A19.quest_desc: [
		"秘银的某些加工环节对&a乙醇&f的消耗大得惊人。研究所食堂不提供酒水，请自行解决。"
		""
		"顺带一提，钻井也是要喝燃料的。柴油动力的产品线值得你好好研究一番。"
	]
	quest.73B7FC9397EA5A19.quest_subtitle: "工业用酒"
	quest.73B7FC9397EA5A19.title: "乙醇"
	quest.749ADB890FB9504E.quest_desc: ["再神奇的魔法也需要一副结实的骨架。&a铁杆束&f正是奥术构件的基底。"]
	quest.749ADB890FB9504E.quest_subtitle: "奥术的骨架"
	quest.749ADB890FB9504E.title: "铁杆束"
	quest.754437DB86A275DA.quest_desc: ["幽匿以经验为食。研究所的粉碎机每天都在 “掉经验”，去把它们收集起来。"]
	quest.754437DB86A275DA.quest_subtitle: "幽匿的口粮"
	quest.754437DB86A275DA.title: "经验颗粒"
	quest.76FDE6739638FE0F.quest_desc: [
		"奥术工业部的终点：&5深渊之心&f。据说只要把它对着强化深板岩的框架举起来，另一个世界的大门就会打开。"
		""
		"上缴&a1024个奥术构件&f，解锁深渊之心的合成。之后的事就交给探险部了——哦，探险部就是你。"
		""
		"&4研究所对门另一边的任何东西概不负责。"
	]
	quest.76FDE6739638FE0F.quest_subtitle: "本章终点"
	quest.76FDE6739638FE0F.title: "深渊之心"
	quest.796CDED810364F15.quest_desc: ["德格米的第一批战利品。它们还都是原料，别急着用。"]
	quest.796CDED810364F15.quest_subtitle: "第一批战利品"
	quest.796CDED810364F15.title: "幽匿催发体"
	quest.7CACDB8FFB80762E.quest_desc: ["有了钻井，秘银溶剂终于不用省着用了。但别忘了，钻井也是要喝乙醇的。"]
	quest.7CACDB8FFB80762E.quest_subtitle: "管够"
	quest.7CACDB8FFB80762E.title: "秘银溶剂"
	quest.7CF73ADC79F427DC.quest_desc: ["附魔装置的第一件作品。请轻拿轻放——虽然它比你结实得多。"]
	quest.7CF73ADC79F427DC.quest_subtitle: "第一件作品"
	quest.7CF73ADC79F427DC.title: "强化回响碎片"
	quest.7D4715FD1E65BB94.quest_desc: [
		"建筑部抱怨说，搭脚手架的时间比搭产线还长。现在你可以隔空放方块、凭空造出临时平台、把方块原地转个方向。"
		""
		"上缴&a256个奥术构件&f，解锁放置方块、构筑法师方块、旋转、交互字形与 “遥指” 形态。"
		""
		"&c法师方块不一定靠得住。请不要用它来搭你的床。"
	]
	quest.7D4715FD1E65BB94.quest_subtitle: "隔空施工"
	quest.7D4715FD1E65BB94.title: "建造法术"
	quest.7E4D4147072B5809.quest_desc: ["欢迎来到GuGuCraft六周目！这是你的奖励，快拿好！"]
	quest.7E4D4147072B5809.title: "欢迎回来！"
	quest.7E89BA85799A724B.quest_desc: ["本章节主要内容为DLC内容的重要节点，你可以在这里看到目前的大致发展阶段"]
	quest.7E89BA85799A724B.title: "摘要"
	quest.7EE498D501BFFCAC.quest_desc: [
		"重复的合成工作交给机器？不，交给&a薇克精&f。只要告诉它做什么，它就会守着药锅一直做下去。"
		""
		"上缴&a256个奥术构件&f，解锁薇克精炼药锅与薇克精护符。"
		""
		"&c薇克精从不加班——因为它们从来不下班。"
	]
	quest.7EE498D501BFFCAC.quest_subtitle: "从不下班"
	quest.7EE498D501BFFCAC.title: "薇克精"
	quest.7F35511B45802CB1.quest_desc: ["汞的原料。仓库里也许还剩一些，但产线可不能只靠库存。"]
	quest.7F35511B45802CB1.quest_subtitle: "汞的原料"
	quest.7F35511B45802CB1.title: "紫水晶碎片"
